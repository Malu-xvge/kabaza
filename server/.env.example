# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------------------
# Payments (PayChangu) — server-only
# ---------------------------------------------------------------------------
# Least-privilege scopes are enough: payment:read, payment:create,
# transaction:read. Never put this in the app or in a committed file.
PAYCHANGU_SECRET_KEY=

# Webhook secret from PayChangu dashboard -> API & Webhooks. The IPN "Signature"
# header is HMAC-SHA256 over the raw request body, keyed with this value.
PAYCHANGU_WEBHOOK_SECRET=

# Leave as-is for real payments. Point at http://localhost:8788 for the local mock.
PAYCHANGU_API_BASE=https://api.paychangu.com

# Public URL of this service, used for PayChangu callback and return URLs.
# On Render this is e.g. https://kabaza-payments.onrender.com
BASE_URL=

# ---------------------------------------------------------------------------
# Data (Supabase) — server-only service role
# ---------------------------------------------------------------------------
# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase SERVICE ROLE key. Server-only: bypasses RLS, never ship to the app.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Server settings
# ---------------------------------------------------------------------------
# Port for local development.
PORT=8787

# Comma-separated allowed origins, or * while testing.
ALLOWED_ORIGINS=*

# ---------------------------------------------------------------------------
# Phone-first OTP (registration + password recovery)
# ---------------------------------------------------------------------------
# Choose one provider: whatsapp or sms. If this is empty, OTP endpoints fail
# closed with 503 provider_not_configured — no code is ever simulated.
OTP_PROVIDER=

# Optional. Overrides the default HMAC secret used to sign short-lived
# verification tokens. If omitted, it is derived from the Supabase service key.
# Use a long random string if you set it (e.g. openssl rand -hex 32).
OTP_TOKEN_SECRET=

# --- WhatsApp Cloud API (OTP_PROVIDER=whatsapp) -----------------------------
# Meta Graph API token with WhatsApp messaging permission.
WHATSAPP_ACCESS_TOKEN=
# Phone number ID from WhatsApp -> API Setup.
WHATSAPP_PHONE_NUMBER_ID=
# direct = Direct Send authentication text message. No template approval is
# needed. The body contains exactly one 6-digit number so Meta can add a
# copy-code button automatically.
# template = use a pre-approved Meta template below (legacy fallback).
WHATSAPP_SEND_MODE=direct
# Graph API version.
WHATSAPP_API_VERSION=v27.0

# Legacy fallback only (WHATSAPP_SEND_MODE=template):
# Approved template name. Meta authentication templates only accept {{1}} = the
# 6-digit code; the expiry text is fixed footer text chosen when the template is
# created. Use WHATSAPP_TEMPLATE_KIND=custom only for a custom utility template
# with {{1}} = code and {{2}} = expiry minutes.
WHATSAPP_OTP_TEMPLATE=kbz_otp
WHATSAPP_TEMPLATE_KIND=authentication
# Template language code approved in Meta Business Manager.
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# --- Generic SMS HTTP adapter (OTP_PROVIDER=sms) ----------------------------
# Any provider that accepts a JSON POST (or GET) can be used. Placeholders:
# {phone} (+265...), {digits} (265...), {code} and {message}.
SMS_API_URL=
SMS_API_METHOD=POST
# Optional JSON object of extra headers, e.g. {"X-API-Key":"abc"}.
SMS_API_HEADERS={}
# Optional bearer token, added as Authorization: Bearer <token>.
SMS_API_AUTH_TOKEN=
# Optional full JSON body template, e.g.
# {"to":"{phone}","message":"{message}"}
SMS_API_BODY_TEMPLATE=
# Message used when no body template is set ({code} is replaced with the OTP).
SMS_API_MESSAGE=Your KABAZA verification code is {code}. It expires in 10 minutes. Never share it.
