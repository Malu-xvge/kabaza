# Copy to .env and fill in. Never commit .env.

# PayChangu secret key (starts with sk_test_ or sk_live_). Never put this in the app.
PAYCHANGU_SECRET_KEY=

# Leave as-is for real payments. Point at http://localhost:8788 for the local mock.
PAYCHANGU_API_BASE=https://api.paychangu.com

# Public URL of this service, used for PayChangu callback and return URLs.
# On Render this is e.g. https://kabaza-payments.onrender.com
BASE_URL=

# Port for local development.
PORT=8787

# Comma-separated allowed origins, or * while testing.
ALLOWED_ORIGINS=*

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase SERVICE ROLE key. Server-only: bypasses RLS, never ship to the app.
SUPABASE_SERVICE_ROLE_KEY=
